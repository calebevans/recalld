+    #[tokio::test]
+    async fn research_supersedes_inherits_score_when_replacement_already_present() {
+        let (old, new) = (MemoryId::new(), MemoryId::new());
+        let distractors: Vec<_> = (0..10).map(|_| MemoryId::new()).collect();
+        let mut outcomes = Vec::new();
+        for already_present in [false, true] {
+            let (graph, meta) = superseded_setup(old, rec(new));
+            let engine = engine(graph, meta);
+            let mut candidates = vec![candidate(rec(old), 0.9)];
+            candidates.extend(distractors.iter().map(|id| candidate(rec(*id), 0.5)));
+            if already_present {
+                candidates.push(candidate(rec(new), 0.1));
+            }
+            engine.resolve_supersedes(
+                &mut candidates, &query(json!({"text": "q"})), &[], ns(),
+            ).await;
+            assert!(!ids(&candidates).contains(&old));
+            assert_eq!(ids(&candidates).iter().filter(|id| **id == new).count(), 1);
+            candidates.sort_by(|a, b| b.composite_score.total_cmp(&a.composite_score));
+            let rank = candidates.iter().position(|c| c.record.id == new).unwrap() + 1;
+            let score = candidates.iter().find(|c| c.record.id == new).unwrap().composite_score;
+            println!("SUPERSESSION already_present={already_present} replacement_score={score} replacement_rank={rank} top10_contains={}", rank <= 10);
+            outcomes.push((score, rank));
+        }
+        assert!(outcomes[0].0 >= 0.9 && outcomes[0].1 == 1, "injected control: {outcomes:?}");
+        assert!(outcomes[1].0 >= 0.9 && outcomes[1].1 == 1,
+            "already-present replacement must inherit the old score too: {outcomes:?}");
+    }
