+fn schema_bytes(path: &Path) -> Vec<u8> {
+    let (_copy, db) = crate::storage::validation::inspect_database(&path.join("meta.db")).unwrap();
+    db.begin_read()
+        .unwrap()
+        .open_table(crate::storage::canonical_schema::SCHEMA)
+        .unwrap()
+        .get("state")
+        .unwrap()
+        .unwrap()
+        .value()
+        .to_vec()
+}
